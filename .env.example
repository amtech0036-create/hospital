# ---------------------------------------------------------
# Server
# ---------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4000
# Production (Vercel + Render), e.g.:
# CORS_ORIGIN=https://amtech-erp.vercel.app,https://*.vercel.app

# ---------------------------------------------------------
# JWT Auth
# ---------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ---------------------------------------------------------
# Database driver
# ---------------------------------------------------------
# Supported values: googlesheets | mongo
# Use "mongo" for MongoDB Atlas (recommended for production).
DB_DRIVER=mongo

# ---------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------
# 1. Create a free cluster at https://cloud.mongodb.com
# 2. Database Access → create a database user
# 3. Network Access → allow your IP (or 0.0.0.0/0 for cloud deploy)
# 4. Connect → Drivers → copy the connection string
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=inventory_erp

# ---------------------------------------------------------
# Google Sheets (legacy — only needed if DB_DRIVER=googlesheets
# or when running scripts/migrate-sheets-to-mongo.js)
# ---------------------------------------------------------
# 1. Create a Google Cloud project.
# 2. Enable the "Google Sheets API" and "Google Drive API".
# 3. Create a Service Account, generate a JSON key.
# 4. Share your Google Sheet with the service account email (Editor access).
# 5. Copy the Spreadsheet ID from the sheet URL.
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Keep the \n escape sequences as-is; the app converts them to real newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------
# Database backup (Google Drive auto-copy — googlesheets driver only)
# ---------------------------------------------------------
# Enable Google Drive API in Google Cloud (in addition to Sheets API).
# Copies are saved next to your spreadsheet in Google Drive.
# Set to 0 to disable automatic copies (manual backup from Settings still works).
BACKUP_DRIVE_AUTO_HOURS=24
# How many Drive backup copies to keep (older ones are deleted automatically).
BACKUP_DRIVE_RETAIN_COUNT=7
# Required for Drive copy: create a folder in Google Drive, share it with the service account (Editor),
# then paste the folder ID from the URL (https://drive.google.com/drive/folders/FOLDER_ID).
BACKUP_DRIVE_FOLDER_ID=
# Optional: your Google account email to own backup copies (auto-detected from spreadsheet if omitted).
BACKUP_DRIVE_OWNER_EMAIL=
