{
  "name": "inventory-erp-system",
  "version": "1.0.0",
  "description": "Inventory, Sales, Purchase, Accounting & Payroll ERP (MongoDB Atlas backend)",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "start:legacy": "node --openssl-legacy-provider backend/server.js",
    "dev": "node --watch backend/server.js",
    "seed:diagnostics": "node scripts/seed-diagnostics.js",
    "seed:tenant": "node scripts/seed-tenant.js",
    "test:diagnostics": "node scripts/test-diagnostic-workflow.js",
    "test:phase11": "node scripts/test-phase11-e2e.js",
    "migrate:db": "node scripts/migrate-database.js",
    "verify:db": "node scripts/verify-indexes-and-cleanup.js",
    "test:subphase14.1": "node scripts/test-subphase14.1-opd.js",
    "test:subphase14.2": "node scripts/test-subphase14.2-emr.js",
    "test:subphase14.3": "node scripts/test-subphase14.3-pharmacy.js",
    "test:subphase14.4": "node scripts/test-subphase14.4-ipd.js",
    "test:subphase14.5": "node scripts/test-subphase14.5-billing.js",
    "test:subphase14.6": "node scripts/test-subphase14.6-store-bloodbank.js",
    "test:phase14": "node scripts/test-subphase14.1-opd.js && node scripts/test-subphase14.2-emr.js && node scripts/test-subphase14.3-pharmacy.js && node scripts/test-subphase14.4-ipd.js && node scripts/test-subphase14.5-billing.js && node scripts/test-subphase14.6-store-bloodbank.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.21.0",
    "morgan": "^1.10.0"
  }
}
